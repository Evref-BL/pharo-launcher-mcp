{
  "name": "@evref-bl/pharo-launcher-mcp",
  "version": "0.3.0",
  "description": "MCP server for controlling Pharo Launcher images, templates, VMs, and processes.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "mcp",
    "pharo",
    "pharo-launcher",
    "pharolauncher",
    "smalltalk"
  ],
  "bin": {
    "pharo-launcher-mcp": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Evref-BL/pharo-launcher-mcp.git"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": "./dist/server.js",
    "./launcher": "./dist/launcher.js",
    "./config": "./dist/config.js",
    "./platform": "./dist/platform.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "docs",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "npm run typecheck && npm run build && npm test",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.check.json && tsc -p tsconfig.scripts.json",
    "test": "npm run test:unit",
    "test:unit": "vitest run --exclude **/*.integration.test.ts",
    "coverage": "vitest run --exclude **/*.integration.test.ts --coverage --coverage.reporter=text --coverage.reporter=lcov",
    "test:integration": "vitest run src/integration/live.integration.test.ts src/integration/lifecycle.integration.test.ts src/integration/copy.integration.test.ts --testTimeout=900000",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "verify:env": "npm run build && node dist/index.js --health",
    "live:smoke": "node scripts/live-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@vitest/coverage-v8": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
